# Runtime selector must be exported to the API process (see CODEX_LOCAL_WORKFLOW.md).
# codex_local is the temporary default; other modes: github_models, github_then_codex.
SOCIALLENS_AI_PROVIDER=codex_local
# Never put secrets in NEXT_PUBLIC_* variables.
# GitHub Models live probe on 2026-11-07 returned plain text OK, not inference JSON.
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
# Used by the local worker. Relative paths are relative to the process working directory.
SOCIALLENS_JOB_DB=.sociallens/jobs.sqlite3
